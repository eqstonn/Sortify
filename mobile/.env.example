# Copy this file to .env and fill in the values. Never commit .env.
# The backend. In the browser: http://localhost:8000. On a phone, localhost won't work:
# use the URL from `cloudflared tunnel --url http://localhost:8000`, or the Render URL. No trailing slash.
EXPO_PUBLIC_API_URL=
# Supabase dashboard > Project Settings > API. The publishable (anon) key only,
# never the service/secret key: everything in EXPO_PUBLIC_ ends up in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
